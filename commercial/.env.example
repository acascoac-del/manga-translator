# Copy ONLY to commercial/.env on the future CPU server. Never use the root .env.
COMMERCIAL_DEBUG=0
COMMERCIAL_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
COMMERCIAL_DOMAIN=YOUR_DOMAIN
COMMERCIAL_PUBLIC_URL=https://YOUR_DOMAIN
COMMERCIAL_DATA_DIR=/srv/data
POSTGRES_HOST=db
POSTGRES_DB=manga
POSTGRES_USER=manga
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@YOUR_DOMAIN
# These switches MUST stay off until benchmark, legal review and integration test.
TRANSLATIONS_ENABLED=0
PAYMENTS_ENABLED=0
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DAILY_JOBS_LIMIT=500
DAILY_TRIAL_LIMIT=20
