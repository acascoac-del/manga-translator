# =============================================================================
# Manga Translator API - Environment Variables
# =============================================================================

# GPU Settings
CUDA_VISIBLE_DEVICES=0
MAX_VRAM_MB=4096

# Pipeline
BATCH_SIZE=4
WORKERS=2

# Translation Service (mymemory | google | libretranslate | ollama)
TRANSLATION_SERVICE=google

# Ollama Config
# Inside Docker Compose, the API container connects to http://ollama:11434
# Running locally, it connects to the exposed port http://localhost:8080
OLLAMA_HOST=http://localhost:8080
OLLAMA_MODEL=llama3

# LibreTranslate (if using self-hosted)
LIBRETRANSLATE_URL=http://localhost:5003

# Server
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=info
