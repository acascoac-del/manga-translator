# =============================================================================
# Manga Translator API - Environment Variables
# Copy to .env and modify as needed
# =============================================================================

# GPU Settings
CUDA_VISIBLE_DEVICES=0
MAX_VRAM_MB=4096

# Pipeline
BATCH_SIZE=4
WORKERS=2

# Translation Service (mymemory | google | libretranslate)
TRANSLATION_SERVICE=mymemory

# LibreTranslate (if using self-hosted)
LIBRETRANSLATE_URL=http://localhost:5003

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
