{
  "manifest_version": 3,
  "name": "MangaTranslatorAR",
  "version": "1.0",
  "description": "Translate manga pages progressively in your browser using your local translator API.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8001/*",
    "http://localhost:8002/*",
    "http://127.0.0.1:8001/*",
    "http://127.0.0.1:8002/*",
    "https://acasco-ac--main-fastapi-endpoint.modal.run/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
