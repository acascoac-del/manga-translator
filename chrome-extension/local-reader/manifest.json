{
  "manifest_version": 3,
  "name": "MangaTranslate AI",
  "version": "0.3.1",
  "minimum_chrome_version": "138",
  "description": "OCR japonés local con Tesseract WebAssembly y traducción local con Chrome Translator cuando esté disponible.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "MangaTranslate AI 0.3.1"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}
}
